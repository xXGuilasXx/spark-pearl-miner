# spark-pearl-miner daemon, as a systemd --user service. It never creates a CUDA context; the GPU
# worker is a separate process (spawned by the daemon, or the spark-miner system unit under
# spark-modo). The GUI and API listen on http://127.0.0.1:4078 only.
#
# Install with packaging/install.sh (no root): it copies the binary to ~/.local/bin, this file to
# ~/.config/systemd/user/ (rewriting %h/.local/bin for another --prefix), then runs
#   systemctl --user daemon-reload && systemctl --user enable --now spark-pearl-miner
# The service always runs, but mines only after the GUI setup and Start; Stop is remembered.
# Keep it running without a desktop session: sudo loginctl enable-linger "$USER"
#
# ExecStartPre checks config.toml first, so an invalid hand edit shows its reason in
# journalctl --user -u spark-pearl-miner; after 5 failed starts in 120 s systemd stops retrying.
[Unit]
Description=spark-pearl-miner daemon (Pearl miner, GUI on http://127.0.0.1:4078)
Documentation=https://github.com/xXGuilasXx/spark-pearl-miner
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStartPre=%h/.local/bin/spark-pearl-miner config check
ExecStart=%h/.local/bin/spark-pearl-miner daemon
Restart=on-failure
RestartSec=5
# SIGTERM goes to the daemon, which tells the worker to exit and saves its state; anything left
# after the timeout is killed.
KillMode=mixed
TimeoutStopSec=20
Environment=RUST_LOG=info
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
