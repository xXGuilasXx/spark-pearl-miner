# Constructed sample in the layout of vLLM's /metrics (V1 engine, two data-parallel engines).
# Expected: running = 3 (2 + 1), waiting = 4 (4 + 0).
# HELP python_gc_objects_collected_total Objects collected during gc
# TYPE python_gc_objects_collected_total counter
python_gc_objects_collected_total{generation="0"} 17876.0
python_gc_objects_collected_total{generation="1"} 4852.0
# HELP python_info Python platform information
# TYPE python_info gauge
python_info{implementation="CPython",major="3",minor="12",patchlevel="3",version="3.12.3"} 1.0
# HELP process_virtual_memory_bytes Virtual memory size in bytes.
# TYPE process_virtual_memory_bytes gauge
process_virtual_memory_bytes 2.7877613568e+010
# HELP process_start_time_seconds Start time of the process since unix epoch in seconds.
# TYPE process_start_time_seconds gauge
process_start_time_seconds 1.79044889532e+09
# HELP vllm:estimated_read_bytes_per_gpu_created Estimated number of bytes read from memory per GPU.
# TYPE vllm:estimated_read_bytes_per_gpu_created gauge
vllm:estimated_read_bytes_per_gpu_created{engine="0",model_name="example-model"} 1.7904491094164703e+09
# HELP vllm:num_requests_running Number of requests in model execution batches.
# TYPE vllm:num_requests_running gauge
vllm:num_requests_running{engine="0",model_name="example-model"} 2.0
vllm:num_requests_running{engine="1",model_name="example-model"} 1.0
# HELP vllm:num_requests_waiting Number of requests waiting to be processed.
# TYPE vllm:num_requests_waiting gauge
vllm:num_requests_waiting{engine="0",model_name="example-model"} 4.0
vllm:num_requests_waiting{engine="1",model_name="example-model"} 0.0
# HELP vllm:num_requests_waiting_by_reason Number of waiting requests by reason. Sum of all reasons equals vllm:num_requests_waiting.
# TYPE vllm:num_requests_waiting_by_reason gauge
vllm:num_requests_waiting_by_reason{engine="0",model_name="example-model",reason="capacity"} 3.0
vllm:num_requests_waiting_by_reason{engine="0",model_name="example-model",reason="deferred"} 1.0
# HELP vllm:num_requests_running_total_fake A made-up metric whose name starts like ours.
# TYPE vllm:num_requests_running_total_fake counter
vllm:num_requests_running_total_fake{engine="0"} 99.0
# HELP vllm:engine_sleep_state Engine sleep state.
# TYPE vllm:engine_sleep_state gauge
vllm:engine_sleep_state{engine="0",model_name="example-model",sleep_state="awake"} 1.0
# HELP vllm:kv_cache_usage_perc KV-cache usage. 1 means 100 percent usage.
# TYPE vllm:kv_cache_usage_perc gauge
vllm:kv_cache_usage_perc{engine="0",model_name="example-model"} 0.42
# HELP vllm:request_prompt_tokens Number of prefill tokens processed.
# TYPE vllm:request_prompt_tokens histogram
vllm:request_prompt_tokens_bucket{engine="0",le="1.0",model_name="example-model"} 0.0
vllm:request_prompt_tokens_bucket{engine="0",le="+Inf",model_name="example-model"} 12.0
vllm:request_prompt_tokens_count{engine="0",model_name="example-model"} 12.0
vllm:request_prompt_tokens_sum{engine="0",model_name="example-model"} 3071.0
# HELP vllm:lora_requests_info Running stats on lora requests.
# TYPE vllm:lora_requests_info gauge
vllm:lora_requests_info{max_lora="1",running_lora_adapters="a,b}",waiting_lora_adapters="say \"hi\""} 1.7e+09
